# Telegram BotFather token. Never commit a real token.
BOT_TOKEN=replace_me
# Numeric Telegram user IDs allowed to administer the bot (comma-separated).
TELEGRAM_ADMIN_IDS=123456789

# GitHub organization and fine-grained PAT.
GITHUB_ORG=hendy-server-AI-hub
GITHUB_TOKEN=replace_me

# Render API key (Bearer token).
RENDER_API_KEY=replace_me

# OpenAI Responses API (optional until /ask is used).
OPENAI_API_KEY=replace_me
OPENAI_MODEL=gpt-6-luna

# Optional fixed HTTPS health endpoints.
# Format: studio=https://studio.example.com/health;admin=https://admin.example.com/health
SERVER_HEALTH_URLS=

# Optional read-only PHP platform bridge.
HENDY_PLATFORM_API_URL=https://hendy-cybertech-platform.onrender.com
HENDY_PLATFORM_API_TOKEN=replace_me

HTTP_TIMEOUT_SECONDS=20
LOG_LEVEL=INFO
AI_MAX_INPUT_CHARS=4000
